# ========================================================
# CITY TOUR CABS - ENVIRONMENT CONFIG
# Copy to `.env` and fill in real values. Never commit `.env`.
# ========================================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="City Tour Cabs"

# ========================================================
# DATABASE
# ========================================================
# Production REQUIRES a PostgreSQL DATABASE_URI. The app refuses to start
# in production without it; it will not fall back to the local SQLite file.
# docker-compose also fails fast if DATABASE_URI is not set.
# Production: Supabase PostgreSQL (use the IPv4 pooler URL)
# DATABASE_URI=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional: PEM CA bundle. When set, Postgres TLS verification is enabled.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Local development only: SQLite archive
DATABASE_URI=file:./data/citytourcabs.db

# ========================================================
# PAYLOAD CMS
# ========================================================
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=<generate-with-openssl-rand-hex-32>
# Set to true only to let Payload push schema changes in production.
DB_PUSH=false

# Only used by `scripts/seed.ts` when the users table is empty.
# Both values are required. Never commit a real value.
# Use a password of at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# One-shot safety switches for destructive scripts. Pass them inline on the
# command line; do not store them in a committed .env file.
# scripts/seed.ts requires this when NODE_ENV=production or DATABASE_URI is PostgreSQL:
# CONFIRM_SEED=YES
# scripts/migrate-to-supabase-and-cloudinary.mjs always requires this:
# CONFIRM_SUPABASE_MIGRATION=YES

# ========================================================
# LEAD NOTIFICATIONS (server-side only)
# ========================================================
N8N_INTERNAL_URL=http://localhost:5678/webhook/booking-notification
N8N_WEBHOOK_TOKEN=
N8N_CHAT_WEBHOOK_URL=
# Legacy alias accepted by /api/chat
CHATBOT_WEBHOOK_URL=

# ========================================================
# ANALYTICS
# ========================================================
NEXT_PUBLIC_GADS_CONVERSION_LABEL=GQMOCJ-eoaMdENL8iIJF
