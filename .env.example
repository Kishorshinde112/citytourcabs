# ========================================================
# 🚖 CITY TOUR CABS - PRODUCTION ENVIRONMENT CONFIG
# ========================================================
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://citytourcabs.in
NEXT_PUBLIC_SITE_NAME="City Tour Cabs"

# ========================================================
# 🗄️ DATABASE CONFIGURATION
# ========================================================
# On Dokploy / PostgreSQL:
# DATABASE_URI=postgresql://postgres:password@postgres-service:5432/citytourcabs_db
# In Local Dev / SQLite mode (uses existing data/citytourcabs.db):
DATABASE_URI=file:./data/citytourcabs.db

# ========================================================
# 🔐 PAYLOAD CMS SECRET KEY
# ========================================================
PAYLOAD_SECRET=citytourcabs-secret-key-32-characters-secure-random

# ========================================================
# ☁️ CLOUDFLARE R2 MEDIA STORAGE (Zero Egress Fees)
# ========================================================
R2_BUCKET=citytourcabs-media
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
NEXT_PUBLIC_MEDIA_URL=https://media.citytourcabs.in

# ========================================================
# ⚡ AUTOMATION & CHATBOT (Internal Dokploy n8n Webhook)
# ========================================================
N8N_INTERNAL_URL=http://n8n-service:5678/webhook/leads
CHATBOT_WEBHOOK_URL=https://n8n.kishorlab.dev/webhook-test/4d6e3906-3c0c-4c18-bef2-cf30563485c0
